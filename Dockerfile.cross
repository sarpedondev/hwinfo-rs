ARG RUST_VERSION=stable

FROM rust:trixie AS toolchain
ARG RUST_VERSION
RUN rustup toolchain install "$RUST_VERSION" --profile minimal
RUN rustup default "$RUST_VERSION"

RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      gcc-aarch64-linux-gnu g++-aarch64-linux-gnu binutils-aarch64-linux-gnu \
      gcc-mingw-w64 g++-mingw-w64 \
      clang && \
    rm -rf /var/lib/apt/lists/*

COPY --from=crazymax/osxcross:14.5-ubuntu /osxcross /osxcross

ENV PATH="/osxcross/bin:${PATH}" \
    LD_LIBRARY_PATH="/osxcross/lib" \
    CC_aarch64_unknown_linux_gnu="aarch64-linux-gnu-gcc" \
    CXX_aarch64_unknown_linux_gnu="aarch64-linux-gnu-g++" \
    AR_aarch64_unknown_linux_gnu="aarch64-linux-gnu-ar" \
    CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER="aarch64-linux-gnu-gcc" \
    CC_x86_64_pc_windows_gnu="x86_64-w64-mingw32-gcc-win32" \
    CXX_x86_64_pc_windows_gnu="x86_64-w64-mingw32-g++-win32" \
    AR_x86_64_pc_windows_gnu="x86_64-w64-mingw32-ar" \
    CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="x86_64-w64-mingw32-gcc-win32" \
    CC_x86_64_apple_darwin="o64-clang" \
    CXX_x86_64_apple_darwin="o64-clang++" \
    AR_x86_64_apple_darwin="x86_64-apple-darwin23.6-ar" \
    CARGO_TARGET_X86_64_APPLE_DARWIN_LINKER="o64-clang" \
    CC_aarch64_apple_darwin="oa64-clang" \
    CXX_aarch64_apple_darwin="oa64-clang++" \
    AR_aarch64_apple_darwin="x86_64-apple-darwin23.6-ar" \
    CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER="oa64-clang"

RUN rustup target add \
      x86_64-unknown-linux-gnu \
      aarch64-unknown-linux-gnu \
      x86_64-pc-windows-gnu \
      x86_64-apple-darwin \
      aarch64-apple-darwin

FROM toolchain AS cross-check
WORKDIR /workspace
COPY . .

RUN cargo build --locked --release --example inventory --target x86_64-unknown-linux-gnu
RUN cargo build --locked --release --example inventory --target aarch64-unknown-linux-gnu
RUN cargo build --locked --release --example inventory --target x86_64-pc-windows-gnu
RUN cargo build --locked --release --example inventory --target x86_64-apple-darwin
RUN cargo build --locked --release --example inventory --target aarch64-apple-darwin
